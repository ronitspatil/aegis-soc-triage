# --- Worker tier (cheap / local) ---
WORKER_PROVIDER=ollama
WORKER_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Reasoner tier (high-stakes synthesis) ---
REASONER_PROVIDER=anthropic
REASONER_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Optional: route either tier through OpenRouter instead ---
# WORKER_PROVIDER=openrouter
# WORKER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_API_KEY=

# --- Security tool backends: mock | live ---
# mock | public (SANS ISC + Shodan, no key needed) | live (VirusTotal)
THREAT_INTEL_PROVIDER=mock
VIRUSTOTAL_API_KEY=
IOC_CACHE_TTL_SECONDS=3600
TOOL_MAX_RETRIES=2


# --- Safety controls ---
SHADOW_MODE=true            # never auto-close; log the counterfactual
KILL_SWITCH=false           # force every alert to a human, no deploy needed
MAX_AUTO_CLOSE_SEVERITY=low # widen only after shadow data justifies it

# --- Persistence (interrupts survive restarts when set) ---
POSTGRES_URL=

# --- Ingestion ---
WEBHOOK_HMAC_SECRET=

# --- Splunk (SIEM source) ---
SPLUNK_URL=https://localhost:8089
SPLUNK_TOKEN=
SPLUNK_VERIFY_SSL=false     # local Splunk uses a self-signed cert; keep true in prod

# --- Slack (analyst approval surface) ---
SLACK_BOT_TOKEN=          # xoxb-...  (chat:write, chat:write.public)
SLACK_APP_TOKEN=          # xapp-...  (Socket Mode; connections:write)
SLACK_CHANNEL=#soc-alerts
SLACK_NOTIFY_AUTO_CLOSE=true

# --- CrowdStrike Falcon (endpoint telemetry) ---
# Base URL is region specific: api.crowdstrike.com | api.us-2... | api.eu-1...
ENDPOINT_PROVIDER=mock          # mock | live
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
FAST_REASONER_MODEL=anthropic/claude-haiku-4.5   # cheap tier for easy alerts
MODEL_TIERING=true
DEDUPE_ENABLED=true
DEDUPE_WINDOW_SECONDS=900

# --- Historical log search (investigation agent) ---
LOG_BACKEND=mock              # mock | splunk
SPLUNK_SEARCH_INDEX=*         # narrow this in production
